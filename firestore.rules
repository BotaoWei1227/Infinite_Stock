rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // 公開唯讀；所有寫入只能由 Cloud Functions（Admin SDK）完成。
    // links / iaLinks（Google ↔ 工坊綁定）不開放任何客戶端存取。
    match /stocks/{id}  { allow read: if true; allow write: if false; }
    match /players/{id} { allow read: if true; allow write: if false; }
    match /feed/{id}    { allow read: if true; allow write: if false; }
  }
}
